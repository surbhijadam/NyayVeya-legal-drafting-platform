# ==============================================================================
# NyayVeya - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual production values.
# NEVER commit the real .env file into version control / Git!
# ==============================================================================

# 1. Flask Core Settings
# Options: development | production | testing
FLASK_ENV=production
# Generate a strong 64-char key in Python: secrets.token_hex(32)
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-production

# 2. Database Configuration
# Local SQLite fallback:
# DATABASE_URL=sqlite:///instance/app.db
# Production MySQL (Recommended for Phase 10):
# DATABASE_URL=mysql+pymysql://nyay_user:YourStrongPassword123!@localhost:3306/nyayveya_db
DATABASE_URL=sqlite:///instance/app.db

# 3. Razorpay Payment Gateway (Live credentials from dashboard.razorpay.com)
# Set to 'live' for real payments, 'test' for sandbox testing
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# 4. HTTPS & Cookie Security (Set to True in production with SSL)
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True

# 5. Initial Administrator Auto-Seed (Optional)
ADMIN_EMAIL=admin@nyayveya.in
ADMIN_PASSWORD=AdminStrongPass2026!
ADMIN_NAME="NyayVeya Superadmin"

# 6. File Storage Path (Optional override)
# GENERATED_DOCUMENTS_FOLDER=/var/data/nyayveya/generated_documents
